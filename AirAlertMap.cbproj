<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{01E2AA95-1657-4288-9159-166365DD2064}</ProjectGuid>
        <ProjectVersion>20.5</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <MainSource>src\AirAlertMap.cpp</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Base</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1048577</TargetedPlatforms>
        <AppType>Application</AppType>
        <ProjectType>CppVCLApplication</ProjectType>
        <SanitizedProjectName>AirAlertMap</SanitizedProjectName>
        <OutputExt>exe</OutputExt>
        <_TCHARMapping>wchar_t</_TCHARMapping>
        <Multithreaded>true</Multithreaded>
        <BCC_UseClassicCompiler>true</BCC_UseClassicCompiler>
        <DynamicRTL>false</DynamicRTL>
        <UsePackages>false</UsePackages>
        <PackageImports>rtl;vcl</PackageImports>
        <ILINK_AdditionalLibs>vcl.lib;rtl.lib;import32.lib;cp32mt.lib</ILINK_AdditionalLibs>
        <IncludePath>$(MSBuildProjectDirectory)\src;$(BDSINCLUDE)\windows\vcl;$(IncludePath)</IncludePath>
        <ILINK_LibraryPath>$(MSBuildProjectDirectory)\src;$(BDS)\lib\win32\release;$(BDS)\lib\win32\release\psdk;$(ILINK_LibraryPath)</ILINK_LibraryPath>
        <IntermediateOutputDir>build\ide\$(Config)</IntermediateOutputDir>
        <FinalOutputDir>build\ide\$(Config)</FinalOutputDir>
        <DCC_Namespace>Winapi;System;System.Win;Vcl</DCC_Namespace>
        <DCC_CBuilderOutput>JPHNE</DCC_CBuilderOutput>
        <Defines>UNICODE;_UNICODE;$(Defines)</Defines>
        <BCC_OptimizeForSpeed>true</BCC_OptimizeForSpeed>
        <TASM_AdditionalSwitches>/ml /m2</TASM_AdditionalSwitches>
        <ProjectName Condition="'$(ProjectName)'==''">AirAlertMap</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64x' and '$(Base)'=='true') or '$(Base_Win64x)'!=''">
        <Base_Win64x>true</Base_Win64x>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <IncludePath>asm\;src\;$(IncludePath)</IncludePath>
        <ILINK_LibraryPath>asm\;src\;$(ILINK_LibraryPath)</ILINK_LibraryPath>
        <SanitizedProjectName>AirAlertMap</SanitizedProjectName>
        <Icon_MainIcon>$(BDS)\bin\cbuilder_PROJECTICON.ico</Icon_MainIcon>
        <UWP_CppLogo44>$(BDS)\bin\Artwork\Windows\UWP\cppreg_UwpDefault_44.png</UWP_CppLogo44>
        <UWP_CppLogo150>$(BDS)\bin\Artwork\Windows\UWP\cppreg_UwpDefault_150.png</UWP_CppLogo150>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <UWP_CppLogo44>$(BDS)\bin\Artwork\Windows\UWP\cppreg_UwpDefault_44.png</UWP_CppLogo44>
        <UWP_CppLogo150>$(BDS)\bin\Artwork\Windows\UWP\cppreg_UwpDefault_150.png</UWP_CppLogo150>
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64)'!=''">
        <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;$(DCC_Namespace)</DCC_Namespace>
        <BT_BuildType>Debug</BT_BuildType>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_Keys>CompanyName=;FileDescription=$(MSBuildProjectName);FileVersion=1.0.0.0;InternalName=;LegalCopyright=;LegalTrademarks=;OriginalFilename=;ProgramID=com.embarcadero.$(MSBuildProjectName);ProductName=$(MSBuildProjectName);ProductVersion=1.0.0.0;Comments=</VerInfo_Keys>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <Manifest_File>$(BDS)\bin\default_app.manifest</Manifest_File>
        <BCC_PCHName_Clang>MapData.h</BCC_PCHName_Clang>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64x)'!=''">
        <DCC_Namespace>Winapi;System.Win;Data.Win;Datasnap.Win;Web.Win;Soap.Win;Xml.Win;$(DCC_Namespace)</DCC_Namespace>
        <BT_BuildType>Debug</BT_BuildType>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_Keys>CompanyName=;FileDescription=$(MSBuildProjectName);FileVersion=1.0.0.0;InternalName=;LegalCopyright=;LegalTrademarks=;OriginalFilename=;ProgramID=com.embarcadero.$(MSBuildProjectName);ProductName=$(MSBuildProjectName);ProductVersion=1.0.0.0;Comments=</VerInfo_Keys>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <Manifest_File>$(BDS)\bin\default_app.manifest</Manifest_File>
        <BCC_EnableBatchCompilation>true</BCC_EnableBatchCompilation>
        <BCC_PCHName_Clang>MapData.h</BCC_PCHName_Clang>
    </PropertyGroup>
    <ItemGroup>
        <AsmCompile Include="asm\AlertAsm.asm">
            <BuildOrder>1</BuildOrder>
        </AsmCompile>
        <CppCompile Include="src\AirAlertMap.cpp">
            <BuildOrder>0</BuildOrder>
        </CppCompile>
        <CppCompile Include="src\AlertModel.cpp">
            <BuildOrder>3</BuildOrder>
        </CppCompile>
        <CppCompile Include="src\AlertFeed.cpp"><BuildOrder>5</BuildOrder></CppCompile>
        <CppCompile Include="src\AlertsHttp.cpp"><BuildOrder>6</BuildOrder></CppCompile>
        <CppCompile Include="src\UkraineAlarmFeed.cpp"><BuildOrder>7</BuildOrder></CppCompile>
        <CppCompile Include="src\ApiCredentials.cpp"><BuildOrder>8</BuildOrder></CppCompile>
        <CppCompile Include="src\AppStorage.cpp"><BuildOrder>9</BuildOrder></CppCompile>
        <HppCompile Include="src\AppStorage.h"/>
        <CppCompile Include="src\WebMapForm.cpp"><BuildOrder>10</BuildOrder></CppCompile>
        <HppCompile Include="src\WebMapForm.h"/>
        <CppCompile Include="src\HistoryReport.cpp"><BuildOrder>11</BuildOrder></CppCompile>
        <HppCompile Include="src\HistoryReport.h"/>
        <HppCompile Include="src\ApiCredentials.h"/>
        <HppCompile Include="src\UkraineAlarmFeed.h"/>
        <HppCompile Include="src\AlertFeed.h"/>
        <HppCompile Include="src\AlertsHttp.h"/>
        <HppCompile Include="src\AlertModel.h">
            <BuildOrder>2</BuildOrder>
        </HppCompile>
        <CppCompile Include="src\MainForm.cpp">
            <Form>MainForm</Form>
            <DependentOn>MainForm.h</DependentOn>
            <BuildOrder>2</BuildOrder>
        </CppCompile>
        <HppCompile Include="src\MainForm.h">
            <BuildOrder>1</BuildOrder>
        </HppCompile>
        <CppCompile Include="src\MapData.cpp">
            <BuildOrder>4</BuildOrder>
        </CppCompile>
        <HppCompile Include="src\MapData.h">
            <BuildOrder>3</BuildOrder>
        </HppCompile>
        <FormResources Include="src\MainForm.dfm"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>CPlusPlusBuilder.Personality.12</Borland.Personality>
        <BorlandProject>
            <CPlusPlusBuilder.Personality>
                <Source>
                    <Source Name="MainSource">src\AirAlertMap.cpp</Source>
                </Source>
                <ProjectProperties>
                    <ProjectProperties Name="AutoShowDeps">False</ProjectProperties>
                    <ProjectProperties Name="ManagePaths">True</ProjectProperties>
                    <ProjectProperties Name="VerifyPackages">True</ProjectProperties>
                    <ProjectProperties Name="IndexFiles">False</ProjectProperties>
                </ProjectProperties>
            </CPlusPlusBuilder.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">False</Platform>
                <Platform value="Win64x">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Cpp.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Cpp.Targets')"/>
    <Target Name="PackageAirAlertAssets" AfterTargets="Build">
        <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\package-assets.ps1&quot; -Destination &quot;$(MSBuildProjectDirectory)\build\ide\$(Config)&quot;"/>
    </Target>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>

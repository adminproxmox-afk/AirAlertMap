#include "version.h"

MAINICON ICON "AirAlertMap.ico"

1 VERSIONINFO
 FILEVERSION APP_VERSION_COMMA
 PRODUCTVERSION APP_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "AirAlertMap contributors\0"
            VALUE "FileDescription", "AirAlertMap - Ukraine air alert map\0"
            VALUE "FileVersion", APP_FILE_VERSION "\0"
            VALUE "InternalName", "AirAlertMap\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 AirAlertMap contributors\0"
            VALUE "OriginalFilename", "AirAlertMap.exe\0"
            VALUE "ProductName", "AirAlertMap\0"
            VALUE "ProductVersion", APP_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
